{
  "name": "tiklive",
  "version": "0.2.0",
  "private": true,
  "description": "TikLive Studio — interactive TikTok LIVE toolkit: alerts, rules engine, goals, games, TTS and OBS automation",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "demo": "node server.mjs --demo",
    "desktop": "electron .",
    "desktop:demo": "electron . --demo",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "cloud": "node cloud/server.mjs",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "release": "electron-builder --publish always",
    "web": "node hosted/main.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "electron-updater": "^6.8.9",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "author": "TikLive Studio",
  "build": {
    "appId": "app.tiklive.studio",
    "productName": "TikLive Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.mjs",
      "src/**",
      "public/**",
      "electron/**",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "TikLive-Studio-Setup.${ext}",
      "shortcutName": "TikLive Studio",
      "uninstallDisplayName": "TikLive Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "artifactName": "TikLive-Studio.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "artifactName": "TikLive-Studio.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YugayV",
        "repo": "tiktok_live",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "TikLive-Studio-Portable.${ext}"
    }
  },
  "desktopName": "tiklive-studio.desktop",
  "tiklive": {
    "cloudUrl": "",
    "checkoutUrl": "",
    "storeId": null,
    "productId": null,
    "priceLabel": "$8 / месяц",
    "trialDays": 7
  },
  "homepage": "https://yugayv.github.io/tiktok_live/",
  "repository": {
    "type": "git",
    "url": "https://github.com/YugayV/tiktok_live.git"
  }
}
